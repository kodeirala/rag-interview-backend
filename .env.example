# Application
APP_NAME=rag-interview-backend
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# OpenAI-compatible LLM + embeddings (required for RAG and booking extraction)
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# PostgreSQL (SQLAlchemy async)
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag

# Redis chat memory
REDIS_URL=redis://localhost:6379/0
CHAT_MEMORY_TTL_SECONDS=86400

# Symmetric encryption for booking PII (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
BOOKING_ENCRYPTION_KEY=

# Ingestion
MAX_UPLOAD_BYTES=10485760
CHUNK_SIZE=800
CHUNK_OVERLAP=120
SENTENCE_WINDOW_SIZE=5
SENTENCE_WINDOW_OVERLAP=1
RETRIEVAL_TOP_K=5
